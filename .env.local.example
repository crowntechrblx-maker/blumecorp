ROBLOX_CLIENT_ID=your_client_id_here
ROBLOX_CLIENT_SECRET=your_client_secret_here
ROBLOX_REDIRECT_URI=http://localhost:5173/api/auth/callback

# .ROBLOSECURITY value from a dedicated, permission-less Roblox account.
# Some communities reject anonymous requests to their member-list API
# (used by Group Search) — this makes those requests look logged-in.
# Never use your main account's cookie here, and never commit the real value.
ROBLOX_SCAN_COOKIE=your_dedicated_accounts_roblosecurity_cookie_here
